{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:static",
  "regions": ["lhr1"],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{views/**,data/**,public/**,scripts/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/:path*", "destination": "/api?__p=:path*" }
  ]
}
